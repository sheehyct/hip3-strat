# hip3-strat-scanner - environment template
#
# Copy this file to `.env` and fill in what you need. NEVER commit `.env`
# (.gitignore covers `.env` and `.env.*`, with this template excepted).
# On a host, set these as the platform's environment variables instead.
#
# Nothing here is required for a local look: `LOG_ONLY=1 node server.js`
# runs with every other variable unset and talks only to Hyperliquid's
# public API.
#
# Load the file with Node's built-in flag (no dotenv package; Node 20.6+):
#
#   node --env-file=.env server.js

# --- Safety ---------------------------------------------------------------
# 1 = log alerts instead of sending them (webhook AND push). Keep this at 1
# for any local boot unless you intend live delivery.
LOG_ONLY=1

# --- Server ---------------------------------------------------------------
# Listen port (default 8787).
#PORT=8787
# Bind address (default 127.0.0.1). The Dockerfile sets 0.0.0.0.
#HOST=127.0.0.1

# --- Universes ------------------------------------------------------------
# Comma-separated universes to TRACK: xyz (HIP-3 builder dex), perps (main
# dex crypto perps). Default: xyz.
#UNIVERSES=xyz
# Tracked universes that ALERT on every coin. Default: xyz.
#ALERT_UNIVERSES=xyz
# Tracked universes that alert for FAVORITED coins only (push registrations
# with a favorites list). Default: perps. Set it to an empty value to turn
# favorites-only alerting off.
#ALERT_FAVS_UNIVERSES=perps

# --- Alert delivery (webhook) ---------------------------------------------
# ntfy | discord | telegram. Unset = no webhook delivery.
ALERT_BACKEND=
# ntfy topic URL or Discord webhook URL. SECRET: anyone holding it can post.
ALERT_WEBHOOK_URL=
# Telegram backend only. The bot token is SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alert delivery (Expo push, for the mobile app) -----------------------
# Shared secret that clients send as the x-push-key header. Unset = the
# /api/push/* routes answer 403 (default-closed). SECRET.
PUSH_REGISTER_KEY=
# Only if Expo Enhanced Push Security is enabled for your app. SECRET.
EXPO_PUSH_ACCESS_TOKEN=

# --- Optional features (all default OFF) ----------------------------------
# 1 = take 15m candles from Hyperliquid's WebSocket instead of REST sweeps.
#CANDLE_FEED=1
# Interval of the REST reconciliation pass while the feed is on, in ms
# (default 3600000). A verification knob.
#FEED_RECONCILE_MS=3600000
# 1 = record served continuity every 30s under data/continuity/ and enable
# POST /api/continuity_at. Needs a persistent data/ volume to be useful.
#CONTINUITY_LEDGER=1
# 1 = turn OFF the component telemetry series under data/telemetry/.
#TELEMETRY_DISABLED=1

# --- Tuning knobs (leave unset unless you have measured a reason) ---------
# Client-side exchange request budget, in weight per minute (default 2000).
#BUDGET_PER_MIN=2000
# Briefing snapshot materialization interval in ms (default 60000).
#BRIEFING_INTERVAL_MS=60000

# --- Underlying equity data (optional) ------------------------------------
# Massive (formerly Polygon.io) API key, used only by src/underlying.js and
# `npm run underlying:check`. SECRET.
MASSIVE_API_KEY=
