{
  "name": "hip3-strat-terminal",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "serve": "expo export --platform web --output-dir dist-web && node server/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "guard:exchange": "node scripts/check-exchange-guard.js",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run guard:exchange && tsc --noEmit && expo export --platform android --output-dir .export-check/android",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@msgpack/msgpack": "3.1.3",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.3",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lightweight-charts": "5.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "playwright": "^1.65.0",
    "typescript": "~6.0.3"
  }
}
